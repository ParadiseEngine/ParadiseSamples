<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Native AOT support to verify generated code is AOT-compatible -->
    <PublishAot>true</PublishAot>
    <!-- Suppress CA1515: internal types warning for this sample project -->
    <!-- PECS016: Allow empty components used as tags -->
    <NoWarn>$(NoWarn);CA1515;PECS016</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Paradise.ECS" />
    <PackageReference Include="Paradise.ECS.Tag" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Paradise.ECS" />
  </ItemGroup>

</Project>
