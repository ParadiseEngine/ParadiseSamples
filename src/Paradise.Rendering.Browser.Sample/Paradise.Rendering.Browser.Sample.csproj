<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <ParadiseEngineRoot Condition="'$(ParadiseEngineRoot)' == ''">$(MSBuildThisFileDirectory)../../engine</ParadiseEngineRoot>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Paradise.Rendering.Browser.Sample</RootNamespace>
    <!-- Enable runtime preload/importmap placeholders. The importmap resolves fingerprinted framework
         assets; _content shim URLs remain stable. -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host sends engine diagnostics to the browser console. -->
    <ProjectReference Include="$(ParadiseEngineRoot)/src/Paradise.Diagnostics/Paradise.Diagnostics.csproj" />
    <ProjectReference Include="$(ParadiseEngineRoot)/src/Paradise.Rendering/Paradise.Rendering.csproj" />
    <ProjectReference Include="$(ParadiseEngineRoot)/src/Paradise.Rendering.Browser/Paradise.Rendering.Browser.csproj" />
    <ProjectReference Include="$(ParadiseEngineRoot)/src/Paradise.Rendering.Pbr/Paradise.Rendering.Pbr.csproj" />
    <ProjectReference Include="$(ParadiseEngineRoot)/src/Paradise.Features.Toml/Paradise.Features.Toml.csproj" />
  </ItemGroup>

  <Import Project="$(ParadiseEngineRoot)/src/Slang.targets" />

  <ItemGroup>
    <SlangShader Include="Shaders/**/*.slang" />
    <SlangShader Include="../Shared/Shaders/showcaseGlass.slang" />
    <SlangIncludeDir Include="$(ParadiseEngineRoot)/src/Paradise.Rendering.Pbr/Shaders/" />
    <SlangShaderInclude Include="$(ParadiseEngineRoot)/src/Paradise.Rendering.Pbr/Shaders/Common/**/*.slang" />
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../engine.toml" LogicalName="engine.toml" />
  </ItemGroup>

</Project>
