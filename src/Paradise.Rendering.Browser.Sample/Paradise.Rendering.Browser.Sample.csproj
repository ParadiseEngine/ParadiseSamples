<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Paradise.Rendering.Browser.Sample</RootNamespace>
    <!-- Enable runtime preload/importmap placeholders. The importmap resolves fingerprinted framework
         assets; _content shim URLs remain stable. -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host sends engine diagnostics to the browser console. -->
    <PackageReference Include="Paradise.Diagnostics" />
    <PackageReference Include="Paradise.Rendering" />
    <PackageReference Include="Paradise.Rendering.Browser" />
    <PackageReference Include="Paradise.Rendering.Pbr" />
    <PackageReference Include="Paradise.Features.Toml" />
  </ItemGroup>

  <ItemGroup>
    <SlangShader Include="Shaders/**/*.slang" />
    <SlangShader Include="../Shared/Shaders/showcaseGlass.slang" />
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../engine.toml" LogicalName="engine.toml" />
  </ItemGroup>

</Project>
