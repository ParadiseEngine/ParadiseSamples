<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <RootNamespace>Paradise.Rendering.Sample</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../engine/src/Paradise.Ui.ImGui/Paradise.Ui.ImGui.csproj" />
    <ProjectReference Include="../../engine/src/Paradise.Windowing.Sdl/Paradise.Windowing.Sdl.csproj" />
    <!-- The sample supplies a diagnostic sink for renderer and device errors. -->
    <ProjectReference Include="../../engine/src/Paradise.Diagnostics/Paradise.Diagnostics.csproj" />
    <ProjectReference Include="../../engine/src/Paradise.Rendering/Paradise.Rendering.csproj" />
    <ProjectReference Include="../../engine/src/Paradise.Windowing/Paradise.Windowing.csproj" />
    <ProjectReference Include="../../engine/src/Paradise.Rendering.WebGPU/Paradise.Rendering.WebGPU.csproj" />
    <ProjectReference Include="../../engine/src/Paradise.Rendering.Pbr/Paradise.Rendering.Pbr.csproj" />
    <ProjectReference Include="../../engine/src/Paradise.Features.Toml/Paradise.Features.Toml.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" />
    <!-- The GLB's directory is mounted, and the mount is what confines its texture uris. -->
    <PackageReference Include="Zio" />
  </ItemGroup>

  <Import Project="../../engine/src/Slang.targets" />

  <ItemGroup>
    <SlangShader Include="Shaders/**/*.slang" />
    <SlangShader Include="../Shared/Shaders/showcaseGlass.slang" />
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <SlangIncludeDir Include="$(MSBuildThisFileDirectory)../../engine/src/Paradise.Rendering.Pbr/Shaders/" />
    <SlangShaderInclude Include="$(MSBuildThisFileDirectory)../../engine/src/Paradise.Rendering.Pbr/Shaders/Common/**/*.slang" />
  </ItemGroup>

</Project>
