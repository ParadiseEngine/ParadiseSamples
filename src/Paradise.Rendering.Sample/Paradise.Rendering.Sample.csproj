<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <RootNamespace>Paradise.Rendering.Sample</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Paradise.Ui.ImGui" />
    <PackageReference Include="Paradise.Windowing.Sdl" />
    <!-- The sample supplies a diagnostic sink for renderer and device errors. -->
    <PackageReference Include="Paradise.Diagnostics" />
    <PackageReference Include="Paradise.Rendering" />
    <PackageReference Include="Paradise.Windowing" />
    <PackageReference Include="Paradise.Rendering.WebGPU" />
    <PackageReference Include="Paradise.Rendering.Pbr" />
    <PackageReference Include="Paradise.Features.Toml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" />
    <!-- The GLB's directory is mounted, and the mount is what confines its texture uris. -->
    <PackageReference Include="Zio" />
  </ItemGroup>

  <ItemGroup>
    <SlangShader Include="Shaders/**/*.slang" />
    <SlangShader Include="../Shared/Shaders/showcaseGlass.slang" />
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
