<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <RootNamespace>Paradise.Ui.ImGui.Sample</RootNamespace>
    <!-- io.IniFilename is a byte* — see the note where it is cleared. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Paradise.Ui.ImGui" />
    <PackageReference Include="Paradise.Rendering.WebGPU" />
    <!-- Forward the window backend's WindowEvent stream through IWindow. -->
    <PackageReference Include="Paradise.Windowing.Sdl" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fonts come out of a mount; this sample builds the system-font overlay. -->
    <PackageReference Include="Zio" />
  </ItemGroup>

</Project>
