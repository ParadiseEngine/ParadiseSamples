{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paradise-samples-route",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "routes": [
    { "pattern": "paradiseengine.dev", "custom_domain": true }
  ],
  "vars": { "PAGES_ORIGIN": "https://paradise-samples.pages.dev" }
}
